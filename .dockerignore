# Виртуальное окружение и кэши — пересоздаются внутри образа через uv sync,
# копировать их с хоста бессмысленно и раздувает build context.
.venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

.git/
.gitignore
.claude/

# Тесты не нужны в рантайм-образе сервисов.
tests/

# Данные и регистр моделей монтируются volume'ами в docker-compose.yml,
# а не запекаются в образ — иначе образ раздувался бы датасетом/весами
# моделей и терял смысл переиспользования между версиями данных/моделей.
data/
model_registry/

# .env передаётся через env_file в docker-compose, а не бейкается в образ —
# иначе конфиг был бы "заморожен" внутри образа и его пришлось бы
# пересобирать при каждом изменении настроек.
.env
.env.*
!.env.example

scripts/
*.md
