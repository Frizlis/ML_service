# Шаблон конфигурации проекта — копируется в .env (который уже в .gitignore
# и не коммитится). Значения ниже совпадают со значениями по умолчанию из
# src/common/config.py — .env нужен в первую очередь для docker-compose
# (env_file) и для явной, видимой в одном месте настройки прод-параметров.

# --- Общие для Inference и Train ---
LOG_LEVEL=INFO
MODEL_REGISTRY_PATH=model_registry

# --- Inference-сервис ---
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000

# --- Train-пайплайн ---
TRAIN_DATA_RAW_PATH=data/raw/News_Category_Dataset_v3.json
TRAIN_DATA_PROCESSED_PATH=data/processed
TRAIN_BASE_MODEL=roberta-base
TRAIN_MAX_LEN=500
TRAIN_BATCH_SIZE=32
TRAIN_ACCUM_STEPS=4
TRAIN_EPOCHS=100
TRAIN_EARLY_STOP=15
TRAIN_LR=2e-5
TRAIN_WARMUP_FRAC=0.1
TRAIN_WEIGHT_DECAY=0.01
# True — замораживает энкодер и обучает только классификационную голову
# (быстрее, меньше VRAM, но обычно слабее качество, чем full fine-tuning).
TRAIN_FREEZE_BASE=True
# LR для режима TRAIN_FREEZE_BASE=True — на порядки выше TRAIN_LR, т.к.
# обучается только голова (см. src/common/config.py).
TRAIN_FREEZE_LR=1e-3
# Метрика, по которой принимается решение о деплое (см. src/train/evaluate.py).
TRAIN_VALIDATION_METRIC=f1_weighted
TRAIN_MIN_METRIC_THRESHOLD=0.55
# Имя сервиса inference в docker-сети compose.
TRAIN_INFERENCE_URL=http://inference:8000
TRAIN_DEPLOY_TIMEOUT_SECONDS=10
TRAIN_SEED=42
